ScreenManager:
    Screen1
    Screen2
    
<Screen1>:
    name: "Home"
    MDBoxLayout:
        orientation:"vertical"
        padding:20
        spacing:20
        
        MDLabel:
            id: working
            text : "OFF"
            bold:True
            font_size: 50
            color:"black"
            halign:"center"
            size_hint:1,0.5
            
        MDRaisedButton:
            text: "Click To Trade" 
            pos_hint:{"center_x": 0.5, "center_y":2}
            size_hint: .3,.1
            on_press:
                working.text= "Placing Orders ..."
            on_release:
                value= app.key[0],app.key[1], app.key[2]
                working.text = f"OFF \n Come back later" if app.key[0] !="" and app.key[1] != "" else "No API key Or API Secret"
               # order.text=  f"ORDER LIST \n\n\n {app.switch(value)}" 
                
        MDScrollView:
            size_hint_y: None
            height: 500
            padding: 20
            MDLabel:
                id: order
                text : "Orders Will Appear Here"
                bold:True
                font_size: 20
                color:"black"
                halign:"center"
                size_hint:1, 0.3
          
        MDGridLayout:
            rows:1
            columns:3
            spacing:3
            size_hint:1,0.1
            
            MDRaisedButton:
                text: "Home"
                size_hint:0.1,0.1
                on_release:
                    app.root.current = "Home"
                
            MDRaisedButton:
                text: "Settings"
                size_hint:0.1,0.1
                on_release:
                    app.root.current = "settings"
            
      
<Screen2>:
    name: "settings"
    MDBoxLayout:
        orientation:"vertical"
        padding: 20
        spacing:20
        
        MDLabel:
            text : "Settings".upper()
            color:"black"
            halign:"center"
            bold :True
            font_size:35
            size_hint:1,.3
            
        MDLabel:
            id: text1
            text:"API Key: "
            color:"black"
            halign:"center"
            size_hint:1,.1
            
        MDTextField:
            id: key
            hint_text: "API Key"
            size_hint:1,.1
            
        MDLabel:
            id : text2
            text:"API Secret: "
            color:"black"
            halign:"center"
            size_hint:1,.1
            
        MDTextField:
            id: secret
            hint_text: "API Secret"
            size_hint: 1,.1
            
        MDLabel:
            text:"Account Type"
            color:"black"
            halign:"center"
            size_hint:1,.1
            
        MDGridLayout:
            rows:3
            columns:2
            size_hint:1,0.2
            
            MDLabel:
                text:"Live"
                color:"black"
                halign:"center"
                size_hint:1,.1
                
            MDLabel:
                text:"Demo"
                color:"black"
                halign:"center"
                size_hint:1,.1
        
            MDCheckbox:
                group:"account"
                on_active:
                    app.key[2] = ""
                    
            MDCheckbox:
                group:"account"
                on_active:
                    app.key[2] = "True"
        
            MDRaisedButton:
                text:"Save"
                size_hint:2,.5
                on_press: 
                    app.key[0] = key.text
                    app.key[1] = secret.text
                    text1.text = f"API Key: {key.text[0:3]}***************{key.text[-3:]}" 
                    text2.text = f"API Secret: {secret.text[0:3]}*************** {secret.text[-3:]}"
                    key.text = ""
                    secret.text = ""
                    
            MDRaisedButton:
                text:"Clear"
                size_hint:2,.5
                on_press: 
                    text1.text = "API Key: " 
                    text2.text = "API Secret: " 
                    app.key[0] = ""
                    app.key[1] = ""
                    
        MDGridLayout:
            rows:1
            spacing:3
            columns:2
            size_hint:1,0.1
            
            MDRaisedButton:
                text: "Home"
                size_hint:0.1,0.1
                on_release:
                    app.root.current = "Home"
                
            MDRaisedButton:
                text: "Settings"
                size_hint:0.1,0.1
                on_release:
                    app.root.current = "settings"
    